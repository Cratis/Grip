<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Grip.Contract</AssemblyName>
        <RootNamespace>Cratis.Grip.Contract</RootNamespace>
        <PackageId>Cratis.Grip.Contract</PackageId>
        <Description>The build contract between Cratis Studio and a builder: the build order Studio hands a builder, the outcome and progress reports it answers with, their published JSON Schemas, and version negotiation.</Description>
        <PackageTags>cratis;grip;studio;builder;build;contract;json-schema</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Fundamentals" />
        <PackageReference Include="JsonSchema.Net" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Schemas/*.schema.json" LogicalName="Cratis.Grip.Contract.%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
